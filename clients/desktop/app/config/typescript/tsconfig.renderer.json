{
  "extends": "../../../../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../../.cache/typescript/renderer.tsbuildinfo",
    "types": ["vite/client"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": [
    "../../src/renderer/**/*.ts",
    "../../src/renderer/**/*.tsx",
    "../../src/shared/**/*.ts"
  ],
  "exclude": ["../../src/**/*.test.ts", "../../src/**/*.test.tsx"]
}
