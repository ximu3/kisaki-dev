{
  "head": "d949e3629ea6e72514c4fe04e4ab1370a5a88918",
  "entries": [
    {
      "file": "clients/desktop/app/package.json",
      "name": "@kisaki3/desktop",
      "category": "desktop-app",
      "private": true,
      "scripts": {
        "dev": "tsx tools/dev/cli.ts",
        "build": "tsx tools/build/cli.ts",
        "package": "tsx tools/package/cli.ts",
        "resources:prepare": "tsx tools/resources/cli.ts",
        "native:build": "tsx tools/native/cli.ts",
        "typecheck": "tsc -b",
        "lint": "eslint . --max-warnings 0",
        "native:check": "tsx tools/native/cli.ts --check",
        "test": "vitest run",
        "test:native": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --config config/vitest/vitest.config.native.ts",
        "test:browser": "vitest run --config config/vitest/vitest.config.browser.ts",
        "test:e2e": "playwright test",
        "test:dev": "vitest run --config config/vitest/vitest.config.dev.ts",
        "test:artifacts": "vitest run --config config/vitest/vitest.config.artifacts.ts",
        "test:performance": "playwright test --config config/playwright/playwright.config.performance.ts",
        "clean": "tsx tools/clean.ts"
      },
      "exports": null,
      "bin": null,
      "review": {
        "dev": {
          "purpose": "真实桌面开发 CLI，管理启动与退出",
          "callers": "根 desktop:dev",
          "recommendation": "保留；当前不承诺自定义 CLI 参数"
        },
        "build": {
          "purpose": "有限应用或单程序构建",
          "callers": "根构建、Turbo 依赖、CI",
          "recommendation": "保留"
        },
        "package": {
          "purpose": "验证并包装已准备的桌面构建",
          "callers": "根完整入口、CI 已准备流程",
          "recommendation": "保留；package 与 npm pack 产物不同"
        },
        "resources:prepare": {
          "purpose": "单独准备当前目标资源",
          "callers": "CONTRIBUTING 手动入口",
          "recommendation": "可统一为 prepare:resources"
        },
        "native:build": {
          "purpose": "准备原生绑定与匹配 ABI 输出",
          "callers": "根开发测试前置、CI、手动",
          "recommendation": "可统一为 build:native"
        },
        "typecheck": {
          "purpose": "检查应用各环境、工具、配置和测试",
          "callers": "根 typecheck、CI",
          "recommendation": "保留"
        },
        "lint": {
          "purpose": "检查应用 TypeScript 源码",
          "callers": "根 lint、CI、手动",
          "recommendation": "保留；原生静态检查另有入口"
        },
        "native:check": {
          "purpose": "执行 Rust 格式与 Clippy 检查",
          "callers": "桌面 CI、手动",
          "recommendation": "可统一为 check:native"
        },
        "test": {
          "purpose": "普通 Node 单元与较小接入测试",
          "callers": "根 test、CI",
          "recommendation": "保留；不误称全部为纯单元"
        },
        "test:native": {
          "purpose": "在匹配 Electron ABI 的 Node 模式运行原生套件",
          "callers": "根入口、桌面 CI",
          "recommendation": "保留环境边界"
        },
        "test:browser": {
          "purpose": "真实 Chromium 中的窗口组件交互",
          "callers": "根入口、桌面 CI",
          "recommendation": "保留环境边界"
        },
        "test:e2e": {
          "purpose": "真实 Electron 窗口、bridge 和关闭",
          "callers": "根入口、桌面 CI",
          "recommendation": "保留"
        },
        "test:dev": {
          "purpose": "隔离工作区中的构建恢复、HMR 和生命周期",
          "callers": "根入口、桌面 CI",
          "recommendation": "保留；职责已另行复核"
        },
        "test:artifacts": {
          "purpose": "启动并验收未改写的打包载体",
          "callers": "根入口、桌面 CI",
          "recommendation": "保留"
        },
        "test:performance": {
          "purpose": "固定次数的启动和正常退出采样",
          "callers": "根入口、桌面 CI",
          "recommendation": "保留"
        },
        "clean": {
          "purpose": "清理应用 out 与 dist，保留缓存和 profile",
          "callers": "根 clean、手动、已有行为测试",
          "recommendation": "保留"
        }
      }
    },
