  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@kisaki3/appearance": "workspace:^",
    "@kisaki3/extension-distribution": "workspace:^",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "valibot": "1.5.0"
  }
}
