{
  "name": "@kisaki3/ui",
  "version": "0.1.0-dev.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "clients/desktop/packages/ui"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsx tools/build.ts",
    "pack": "pnpm pack --out out/package.tgz",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test:consumers": "publint out/package.tgz --strict && attw out/package.tgz --profile esm-only --exclude-entrypoints styles.css",
    "clean": "tsx tools/clean.ts"
  },
  "dependencies": {
    "@kisaki3/appearance": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.9.16"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@kisaki3/eslint-config": "workspace:*",
    "@kisaki3/tooling": "workspace:*",
    "@kisaki3/typescript-config": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "publint": "0.3.25",
    "solid-js": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-solid": "catalog:",
    "vitest": "catalog:"
  }
}
