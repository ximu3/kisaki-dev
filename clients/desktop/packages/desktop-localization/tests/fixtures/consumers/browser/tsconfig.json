{
  "compilerOptions": {
    "target": "ES2023",
    "rootDir": ".",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["*.ts"]
}
