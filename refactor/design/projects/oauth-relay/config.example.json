{
  "publicOrigin": "https://relay.example.invalid",
  "listen": { "host": "0.0.0.0", "port": 3000 },
  "limits": {
    "authorizationSeconds": 600,
    "exchangeSeconds": 60,
    "upstreamTimeoutSeconds": 20,
    "shutdownSeconds": 25,
    "maxSessions": 1024,
    "maxUpstreamRequests": 64,
    "maxRequestBytes": 16384,
    "maxResponseBytes": 1048576
  },
  "applications": {
    "example-desktop": {
      "redirects": [
        { "kind": "loopback", "host": "127.0.0.1", "path": "/oauth/callback" },
        { "kind": "loopback", "host": "::1", "path": "/oauth/callback" }
      ],
      "corsOrigins": [],
      "providers": {
        "bangumi": {
          "clientId": "example-bangumi-client",
          "clientSecretEnv": "EXAMPLE_BANGUMI_SECRET",
          "allowedScopes": [],
          "defaultScopes": []
        },
        "anilist": {
          "clientId": "example-anilist-client",
          "clientSecretEnv": "EXAMPLE_ANILIST_SECRET",
          "allowedScopes": [],
          "defaultScopes": []
        },
        "google": {
          "clientId": "example-google-client.apps.googleusercontent.com",
          "clientSecretEnv": "EXAMPLE_GOOGLE_SECRET",
          "allowedScopes": ["openid", "email"],
          "defaultScopes": ["openid", "email"],
          "authorization": { "accessType": "offline", "includeGrantedScopes": false }
        }
      }
    }
  }
}
