{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": [".node-version", ".npmrc", "pnpm-workspace.yaml"],
  "tasks": {
    "check:package": {
      "dependsOn": ["pack"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
      "outputs": [],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "prepare:build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!tests/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!vitest.config.ts",
        "!playwright.config.ts",
        "!config/vitest/**",
        "!config/playwright/**",
        "!config/typescript/tsconfig.tests.json",
        "!eslint.config.ts"
      ],
      "outputs": ["dist/**"],
      "env": ["TSDOWN_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/packages/eslint-config/src/**",
        "$TURBO_ROOT$/packages/eslint-config/package.json",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "@kisaki3/tooling#test": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#root:typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "//#root:lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "config/typescript/**",
        "*.config.ts",
        "config/**/*.ts",
        "tools/**/*.ts",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "$TURBO_ROOT$/packages/eslint-config/src/**",
        "$TURBO_ROOT$/packages/eslint-config/package.json",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ],
      "outputs": []
    },
    "//#root:test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "cache": false
    },
    "pack": {
      "dependsOn": ["build"],
      "inputs": ["package.json", "LICENSE", "NOTICE", "release-notes/**"],
      "outputs": ["out/package/**"],
      "cache": false
    },
    "test:consumers": {
      "dependsOn": ["check:package"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
      "cache": false
    },
    "prepare:build": {
      "cache": false,
      "inputs": ["package.json"],
      "outputs": []
    },
    "check:boundaries": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!tests/**/fixtures/**",
        "$TURBO_ROOT$/.dependency-cruiser.json",
        "$TURBO_ROOT$/tools/boundaries.ts",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/config/typescript/**"
      ],
      "outputs": []
    },
    "//#root:boundaries": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "config/typescript/**",
        "*.config.ts",
        "config/**/*.ts",
        "tools/**/*.ts",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        ".dependency-cruiser.json"
      ],
      "outputs": []
    }
  }
}
