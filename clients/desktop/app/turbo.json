{
  "extends": ["//"],
  "tasks": {
    "test": {
      "cache": false
    },
    "prepare:electron": {
      "inputs": ["package.json"],
      "cache": false
    },
    "test:native": {
      "dependsOn": ["^build", "build:native", "prepare:resources", "prepare:electron"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "drizzle/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/native/**",
        "tools/resources/**",
        "tools/lib/**",
        "config/vitest/vitest.config.native.ts",
        "tests/integration/native/**",
        "tests/integration/database/**",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "tests/integration/files/**"
      ],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build:fixture", "prepare:electron"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "drizzle/**",
        "tests/fixtures/runtime/src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "playwright.config.ts",
        "tests/e2e/**",
        "tests/support/electron.ts",
        "tools/dev/electron-executable.ts",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json"
      ],
      "cache": false
    },
    "test:artifacts": {
      "dependsOn": ["package:fixture", "prepare:electron"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "drizzle/**",
        "electron-builder.yml",
        "$TURBO_ROOT$/LICENSE",
        "tests/fixtures/runtime/src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/package/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "config/vitest/vitest.config.artifacts.ts",
        "tests/artifacts/**",
        "tests/support/artifact*.ts",
        "tools/dev/electron-executable.ts",
        "tests/support/window-observation.ts",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json"
      ],
      "cache": false
    },
    "test:performance": {
      "dependsOn": ["build:fixture", "prepare:electron"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "drizzle/**",
        "tests/fixtures/runtime/src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "config/playwright/playwright.config.performance.ts",
        "tests/performance/**",
        "tests/support/electron.ts",
        "tools/dev/electron-executable.ts",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json"
      ],
      "cache": false
    },
    "test:dev": {
      "dependsOn": ["^build", "build:native", "prepare:electron"],
      "env": ["TSDOWN_*", "MACOSX_DEPLOYMENT_TARGET"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "drizzle/**",
        "tools/dev/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "config/vitest/vitest.config.dev.ts",
        "tests/tools/dev/**",
        "tests/support/development/**",
        "tests/support/fixture-application.ts",
        "tests/support/preparation-worker.ts",
        "tests/support/window-observation.ts",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json",
        "tests/fixtures/runtime/src/**"
      ],
      "cache": false
    },
    "build:fixture": {
      "dependsOn": ["^build", "build:native", "prepare:resources"],
      "env": ["$TURBO_EXTENDS$", "MACOSX_DEPLOYMENT_TARGET"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "drizzle/**",
        "tests/fixtures/runtime/src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json"
      ],
      "outputs": ["out/windows-*/**", "out/macos-*/**", "out/linux-*/**"],
      "cache": false
    },
    "package:fixture": {
      "dependsOn": ["build:fixture"],
      "env": ["KISAKI_MAC_SIGNING_IDENTITY", "MACOSX_DEPLOYMENT_TARGET", "TSDOWN_*"],
      "inputs": [
        "src/**",
        "!src/**/*.test.ts",
        "drizzle/**",
        "electron-builder.yml",
        "$TURBO_ROOT$/LICENSE",
        "tests/fixtures/runtime/src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "tools/package/**",
        "!config/typescript/tsconfig.tests.json"
      ],
      "cache": false
    },
    "build:native": {
      "inputs": [
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "tools/native/**",
        "tools/lib/**",
        "package.json"
      ],
      "outputs": ["out/native/**"],
      "env": ["MACOSX_DEPLOYMENT_TARGET"],
      "cache": false
    },
    "prepare:resources": {
      "inputs": [
        "assets/**",
        "!**/*.md",
        "tools/resources/**",
        "tools/lib/**",
        "package.json",
        "drizzle/**"
      ],
      "outputs": ["out/resources/**"],
      "cache": false
    },
    "check:native": {
      "inputs": ["native/**", "!native/target/**", "!**/*.md", "tools/native/**"],
      "cache": false
    }
  }
}
