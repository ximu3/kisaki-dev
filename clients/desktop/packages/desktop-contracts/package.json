      "types": "./dist/text-rules.d.ts",
      "import": "./dist/text-rules.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./ingest": {
      "types": "./dist/ingest.d.ts",
