{
  "name": "@kisaki3/extension-cli",
  "version": "0.1.0-dev.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "clients/desktop/packages/extension-cli"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "tsx tools/build.ts",
    "typecheck": "tsx ../../../../tools/outputs/run.ts --dependencies -- exec tsc -b",
    "pack": "tsx ../../../../tools/outputs/run.ts --read dist --write out -- pack --out out/package.tgz",
    "test:consumers": "tsx ../../../../tools/outputs/run.ts --read out -- --shell-mode exec \"publint out/package.tgz --strict && attw out/package.tgz --profile esm-only\"",
    "clean": "tsx tools/clean.ts"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:",
    "publint": "0.3.25",
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "catalog:",
    "tsx": "catalog:"
  }
}
