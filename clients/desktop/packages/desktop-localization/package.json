{
  "name": "@kisaki3/desktop-localization",
  "version": "0.1.0-dev.0",
  "description": "English messages, typed translation calls and pure localization formatting for Kisaki.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki-dev.git",
    "directory": "clients/desktop/packages/desktop-localization"
  },
  "files": [
    "dist",
    "LICENSE",
    "release-notes",
    "API.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "kisaki-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.23",
    "@kisaki3/desktop-contracts": "workspace:^",
    "intl-messageformat": "^12.2.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@kisaki3/config": "workspace:*",
    "@kisaki3/tooling": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
