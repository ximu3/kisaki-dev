{
  "name": "@kisaki3/extension-api",
  "description": "Public extension capabilities, author contracts, and versioned SDK endpoint messages for Kisaki.",
  "version": "0.1.0-dev.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "clients/desktop/packages/extension-api"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./webview": {
      "types": "./dist/webview.d.ts",
      "import": "./dist/webview.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "scripts": {
    "build": "tsx tools/build.ts",
    "pack": "pnpm pack --out out/package.tgz",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "check:package": "publint out/package.tgz --strict && attw out/package.tgz --profile esm-only",
    "clean": "tsx tools/clean.ts"
  },
  "dependencies": {
    "@kisaki3/desktop-contracts": "workspace:^",
    "@kisaki3/extension-distribution": "workspace:^",
    "semver": "7.8.5",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@kisaki3/eslint-config": "workspace:*",
    "@kisaki3/tooling": "workspace:*",
    "@kisaki3/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "7.8.0",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "publint": "0.3.25",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
