    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@kisaki3/tooling": "workspace:*",
    "@kisaki3/typescript-config": "workspace:*",
    "@napi-rs/cli": "3.10.9",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "catalog:",
