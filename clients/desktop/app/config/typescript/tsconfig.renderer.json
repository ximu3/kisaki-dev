{
  "extends": "@kisaki3/typescript-config/solid.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../../.cache/typescript/renderer.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": [
    "../../src/renderer/**/*.ts",
    "../../src/renderer/**/*.tsx",
    "../../src/shared/**/*.ts"
  ],
  "exclude": ["../../src/**/*.test.ts", "../../src/**/*.test.tsx"]
}
