{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": [".node-version", ".npmrc", "pnpm-workspace.yaml"],
  "tasks": {
    "check:package": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "//#desktop:test:consumers": {
      "dependsOn": ["@kisaki3/desktop-appearance#check:package"],
      "inputs": [
        "package.json",
        "tests/desktop/consumers/**",
        "config/vitest/consumers.ts",
        "tools/desktop/packages.ts"
      ],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!tests/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!vitest.config.ts",
        "!playwright.config.ts",
        "!config/vitest/**",
        "!config/playwright/**",
        "!config/typescript/tsconfig.tests.json",
        "!eslint.config.ts"
      ],
      "outputs": ["dist/**"],
      "env": ["TSDOWN_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/packages/eslint-config/src/**",
        "$TURBO_ROOT$/packages/eslint-config/package.json",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "@kisaki3/tooling#test": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#root:typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "//#root:lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "config/typescript/**",
        "*.config.ts",
        "config/**/*.ts",
        "tools/**/*.ts",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "$TURBO_ROOT$/packages/eslint-config/src/**",
        "$TURBO_ROOT$/packages/eslint-config/package.json",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ],
      "outputs": []
    },
    "//#root:test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "cache": false
    },
    "//#check:boundaries": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/tests/**/fixtures/**",
        "!refactor/**",
        "!.github/**"
      ],
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
