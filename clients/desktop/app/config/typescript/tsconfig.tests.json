{
  "extends": "@kisaki3/typescript-config/solid.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../../.cache/typescript/tests.tsbuildinfo",
    "types": ["node", "vite/client"],
    "lib": ["ES2023", "ES2024.Promise", "DOM", "DOM.Iterable"]
  },
  "include": [
    "../../src/**/*.test.ts",
    "../../tests/**/*.ts",
    "../../tests/**/*.tsx",
    "../../native/node/**/*.test.ts",
    "../../tools/**/*.test.ts"
  ],
  "exclude": ["../../tests/fixtures/runtime/src/**"]
}
