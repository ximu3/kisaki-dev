{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": [".node-version", ".npmrc", "pnpm-workspace.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!tests/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!vitest.config.ts",
        "!playwright.config.ts",
        "!config/vitest/**",
        "!config/playwright/**",
        "!config/typescript/tsconfig.tests.json",
        "!eslint.config.ts"
      ],
      "outputs": ["dist/**"],
      "env": ["TSDOWN_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/packages/eslint-config/src/**",
        "$TURBO_ROOT$/packages/eslint-config/package.json",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [],
      "cache": false
    },
    "pack": {
      "dependsOn": ["build"],
      "inputs": ["package.json", "README.md", "LICENSE", "LICENSE.*", ".npmignore"],
      "outputs": ["out/*.tgz"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#root:typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "//#root:lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "config/typescript/**",
        "*.config.ts",
        "config/**/*.ts",
        "tools/**/*.ts",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "$TURBO_ROOT$/packages/eslint-config/src/**",
        "$TURBO_ROOT$/packages/eslint-config/package.json",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ],
      "outputs": []
    },
    "//#root:test": {
      "dependsOn": ["^build", "@kisaki3/extension-cli#build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "cache": false
    },
    "//#check:boundaries": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/tests/**/fixtures/**",
        "!refactor/**",
        "!.github/**"
      ],
      "dependsOn": [
        "@kisaki3/appearance#build",
        "@kisaki3/desktop-contracts#build",
        "@kisaki3/extension-api#build",
        "@kisaki3/extension-cli#build",
        "@kisaki3/extension-distribution#build",
        "@kisaki3/extension-sdk#build",
        "@kisaki3/rpc#build",
        "@kisaki3/ui#build"
      ],
      "outputs": []
    },
    "check:package": {
      "dependsOn": ["pack"],
      "inputs": ["package.json"],
      "cache": false
    },
    "//#desktop:packages:test:consumers:prepared": {
      "inputs": [
        "tests/desktop/**",
        "config/vitest/vitest.config.desktop-consumers.ts",
        "tools/desktop/**",
        "!**/*.md"
      ],
      "cache": false
    }
  }
}
