{
  "extends": ["//"],
  "tasks": {
    "test": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["$TURBO_EXTENDS$", "MACOSX_DEPLOYMENT_TARGET"],
      "inputs": [
        "tests/fixtures/runtime/src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json"
      ],
      "outputs": ["out/**"],
      "cache": false
    },
    "test:native": {
      "dependsOn": [],
      "inputs": [
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "tests/fixtures/runtime/src/main/**",
        "tests/fixtures/runtime/src/shared/**",
        "assets/**",
        "tools/native/**",
        "tools/resources/**",
        "tools/lib/**",
        "config/vitest/vitest.config.native.ts",
        "tests/integration/native/**",
        "tests/integration/database/**",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts"
      ],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "inputs": [
        "tests/fixtures/runtime/src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "playwright.config.ts",
        "tests/e2e/**",
        "tests/support/electron.ts",
        "tools/dev/electron-executable.ts",
        "tests/support/window-observation.ts",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json"
      ],
      "cache": false
    },
    "test:artifacts": {
      "dependsOn": ["^build"],
      "inputs": [
        "electron-builder.yml",
        "$TURBO_ROOT$/LICENSE",
        "tests/fixtures/runtime/src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/package/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "config/vitest/vitest.config.artifacts.ts",
        "tests/artifacts/**",
        "tests/support/artifact*.ts",
        "tools/dev/electron-executable.ts",
        "tests/support/window-observation.ts",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json"
      ],
      "cache": false
    },
    "test:performance": {
      "dependsOn": ["^build"],
      "inputs": [
        "tests/fixtures/runtime/src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "config/playwright/playwright.config.performance.ts",
        "tests/performance/**",
        "tests/support/electron.ts",
        "tools/dev/electron-executable.ts",
        "tests/support/window-observation.ts",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json"
      ],
      "cache": false
    },
    "test:dev": {
      "dependsOn": [],
      "env": ["TSDOWN_*", "MACOSX_DEPLOYMENT_TARGET"],
      "inputs": [
        "tools/dev/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "config/vitest/vitest.config.dev.ts",
        "tests/tools/dev/**",
        "tests/support/development*.ts",
        "tests/support/preparation-worker.ts",
        "tests/support/window-observation.ts",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json",
        "tests/fixtures/runtime/src/**"
      ],
      "cache": false
    },
    "test:package": {
      "dependsOn": ["build"],
      "env": ["KISAKI_MAC_SIGNING_IDENTITY", "MACOSX_DEPLOYMENT_TARGET", "TSDOWN_*"],
      "inputs": [
        "electron-builder.yml",
        "$TURBO_ROOT$/LICENSE",
        "tests/fixtures/runtime/src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "tools/package/**",
        "!config/typescript/tsconfig.tests.json"
      ],
      "cache": false
    }
  }
}
