{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["$TURBO_EXTENDS$", "MACOSX_DEPLOYMENT_TARGET"],
      "inputs": [
        "src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json"
      ],
      "outputs": ["out/**"],
      "cache": false
    },
    "dev": {
      "persistent": true,
      "env": ["TSDOWN_*", "MACOSX_DEPLOYMENT_TARGET"],
      "cache": false
    },
    "package": {
      "dependsOn": ["build"],
      "env": ["KISAKI_MAC_SIGNING_IDENTITY", "MACOSX_DEPLOYMENT_TARGET", "TSDOWN_*"],
      "inputs": [
        "electron-builder.yml",
        "$TURBO_ROOT$/LICENSE",
        "src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "tools/package/**",
        "packaging/**",
        "!config/typescript/tsconfig.tests.json"
      ],
      "cache": false
    },
    "test:native": {
      "dependsOn": [],
      "inputs": [
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "src/main/**",
        "src/shared/**",
        "assets/**",
        "tools/native/**",
        "tools/resources/**",
        "tools/lib/**",
        "config/vitest/vitest.config.native.ts",
        "tests/integration/native/**",
        "tests/integration/database/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts"
      ],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "playwright.config.ts",
        "tests/e2e/**",
        "tests/support/electron.ts",
        "tools/dev/electron-executable.ts",
        "tests/support/window-observation.ts",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json"
      ],
      "cache": false
    },
    "test:artifacts": {
      "dependsOn": ["^build"],
      "inputs": [
        "electron-builder.yml",
        "$TURBO_ROOT$/LICENSE",
        "src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/package/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "config/vitest/vitest.config.artifacts.ts",
        "tests/artifacts/**",
        "tests/support/artifact*.ts",
        "tools/dev/electron-executable.ts",
        "tests/support/window-observation.ts",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "packaging/**",
        "!config/typescript/tsconfig.tests.json"
      ],
      "cache": false
    },
    "test:browser": {
      "dependsOn": ["@kisaki3/ui#build"],
      "inputs": [
        "src/renderer/**",
        "src/shared/**",
        "tests/browser/**",
        "config/vitest/vitest.config.browser.ts"
      ],
      "cache": false
    },
    "test:performance": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "config/playwright/playwright.config.performance.ts",
        "tests/performance/**",
        "tests/support/electron.ts",
        "tools/dev/electron-executable.ts",
        "tests/support/window-observation.ts",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json"
      ],
      "cache": false
    },
    "test:dev": {
      "dependsOn": ["@kisaki3/extension-cli#build"],
      "env": ["TSDOWN_*", "MACOSX_DEPLOYMENT_TARGET"],
      "inputs": [
        "tools/dev/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "src/main/**",
        "src/preload/**",
        "src/extension-host/**",
        "src/shared/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "config/vitest/vitest.config.dev.ts",
        "tests/tools/dev/**",
        "tests/support/development*.ts",
        "tests/support/preparation-worker.ts",
        "tests/support/window-observation.ts",
        "$TURBO_ROOT$/clients/desktop/packages/*/package.json",
        "$TURBO_ROOT$/clients/desktop/packages/*/tsdown.config.ts",
        "$TURBO_ROOT$/clients/desktop/packages/*/config/**",
        "$TURBO_ROOT$/clients/desktop/packages/*/tools/**",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json",
        "!$TURBO_ROOT$/clients/desktop/packages/*/config/typescript/tsconfig.tests.json",
        "!$TURBO_ROOT$/clients/desktop/packages/*/config/vitest/**",
        "!$TURBO_ROOT$/clients/desktop/packages/*/config/playwright/**"
      ],
      "cache": false
    }
  }
}
