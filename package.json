{
  "name": "@kisaki3/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "24.11.1"
  },
  "scripts": {
    "desktop:dev": "turbo run dev --filter=@kisaki3/desktop",
    "desktop:build": "turbo run build --filter=@kisaki3/desktop --",
    "desktop:package": "turbo run package --filter=@kisaki3/desktop --",
    "desktop:test:native": "turbo run test:native --filter=@kisaki3/desktop --",
    "desktop:test:browser": "turbo run test:browser --filter=@kisaki3/desktop --",
    "desktop:test:e2e": "turbo run test:e2e --filter=@kisaki3/desktop --",
    "desktop:test:artifacts": "pnpm --filter @kisaki3/desktop test:artifacts",
    "desktop:test:performance": "turbo run test:performance --filter=@kisaki3/desktop --",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck typecheck:root",
    "lint": "turbo run lint lint:root check:boundaries",
    "lint:fix": "pnpm lint:root --fix && pnpm -r --if-present lint --fix",
    "test": "turbo run test test:root",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "packages:pack": "turbo run pack --filter=./clients/desktop/packages/* && tsx tools/release/package-inputs.ts",
    "test:consumers": "pnpm packages:pack && turbo run test:consumers --filter=./clients/desktop/packages/* && pnpm test:consumers:run",
    "hooks:install": "tsx tools/hooks.ts install",
    "hooks:uninstall": "tsx tools/hooks.ts uninstall",
    "clean": "turbo run clean",
    "test:consumers:run": "vitest run --config config/vitest/vitest.config.consumers.ts",
    "desktop:test:dev": "turbo run test:dev --filter=@kisaki3/desktop --",
    "typecheck:root": "tsc -b",
    "lint:root": "eslint \"*.config.ts\" config tools tests --max-warnings 0",
    "check:boundaries": "depcruise --config .dependency-cruiser.json clients packages tools",
    "test:root": "vitest run"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "catalog:",
    "husky": "9.1.7",
    "jiti": "catalog:",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "@kisaki3/typescript-config": "workspace:*",
    "@kisaki3/eslint-config": "workspace:*",
    "@kisaki3/tooling": "workspace:*"
  }
}
