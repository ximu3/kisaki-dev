{
  "name": "@kisaki3/workspace",
  "description": "Workspace tasks and repository engineering for Kisaki.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "build": "vp run --filter \"./clients/desktop/packages/*\" build",
    "typecheck": "vp run -r typecheck:project",
    "typecheck:project": "tsc -b",
    "lint": "vp lint --type-aware && vp run check:boundaries",
    "check:boundaries": "node tools/boundaries.ts",
    "format:check": "vp fmt --check",
    "format": "vp fmt --write",
    "test": "vp run -r test:unit",
    "test:unit": "vp test run",
    "check": "vp run build && vp run typecheck && vp run lint && vp run format:check && vp run test",
    "desktop:build:fixture": "vp run @kisaki3/desktop#build:fixture",
    "desktop:package:fixture": "vp run @kisaki3/desktop#package:fixture",
    "desktop:packages:pack": "vp run --filter \"./clients/desktop/packages/*\" archive",
    "desktop:packages:check": "vp run --filter \"./clients/desktop/packages/*\" check:package",
    "desktop:test:consumers": "vp run --filter \"./clients/desktop/packages/*\" test:consumers",
    "desktop:test:native": "vp run @kisaki3/desktop#test:native",
    "desktop:test:dev": "vp run @kisaki3/desktop#test:dev",
    "desktop:test:artifacts": "vp run @kisaki3/desktop#test:artifacts",
    "desktop:test:performance": "vp run @kisaki3/desktop#test:performance",
    "clean": "vp run --filter \"./clients/desktop/**\" clean:outputs",
    "install:hooks": "vp config --hooks --no-agent",
    "uninstall:hooks": "vp hooks disable",
    "desktop:test:browser": "vp run @kisaki3/desktop-ui#test:browser",
    "desktop:test:windows": "vp run @kisaki3/desktop#test:windows"
  },
  "devDependencies": {
    "@kisaki3/tooling": "workspace:*",
    "@kisaki3/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "dependency-cruiser": "18.7.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  }
}
