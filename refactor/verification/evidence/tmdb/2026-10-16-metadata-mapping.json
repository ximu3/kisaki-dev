  "findings": {
    "primaryReleaseDate": "TMDB chooses a primary date using a theatrical-first precedence, followed by premiere and other release types; it is not necessarily the earliest public release.",
    "movieRuntime": "The contribution guide requests original runtime including credits, rounded up to whole minutes for each translation.",
    "releasedStatus": "The guide says a bot changes a movie to Released four days before the world premiere; this is not a reliable direct mapping to native finished release status.",
    "adultFlag": "The guide defines adult primarily for hardcore pornography, not all sensitive content.",
    "creditScope": "Credit details can contain actual seasons with season_number and show_id. TV credits must be scoped before creating native season participation.",
    "seasonAssets": "Season image responses contain posters only, while movie images have posters, backdrops and logos. Episode images contain stills.",
    "collection": "Movie collection membership is not itself a typed sequel/prequel/remake relation."
  },
