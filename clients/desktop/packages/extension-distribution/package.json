{
  "name": "@kisaki3/extension-distribution",
  "description": "Extension manifests, registries, compatibility, localization and Ed25519 signing.",
  "version": "0.1.0-dev.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "clients/desktop/packages/extension-distribution"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./compatibility": {
      "types": "./dist/compatibility.d.ts",
      "import": "./dist/compatibility.js"
    },
    "./node/signing": {
      "types": "./dist/node/signing.d.ts",
      "import": "./dist/node/signing.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    }
  },
  "scripts": {
    "build": "tsx tools/build.ts",
    "pack": "pnpm pack --out out/package.tgz",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check:package": "publint out/package.tgz --strict && attw out/package.tgz --profile esm-only",
    "clean": "tsx tools/clean.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@kisaki3/eslint-config": "workspace:*",
    "@kisaki3/tooling": "workspace:*",
    "@kisaki3/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "7.8.0",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "publint": "0.3.25",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "0.9.0",
    "canonicalize": "5.1.0",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "valibot": "1.5.0"
  }
}
