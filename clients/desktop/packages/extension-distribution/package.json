{
  "name": "@kisaki3/extension-distribution",
  "version": "0.1.0-dev.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki.git",
    "directory": "clients/desktop/packages/extension-distribution"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    }
  },
  "scripts": {
    "build": "tsx tools/build.ts",
    "typecheck": "tsc -b",
    "pack": "pnpm pack --out out/package.tgz",
    "test:consumers": "publint out/package.tgz --strict && attw out/package.tgz --profile esm-only",
    "clean": "tsx tools/clean.ts",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:",
    "publint": "0.3.25",
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "@kisaki3/typescript-config": "workspace:*",
    "@kisaki3/eslint-config": "workspace:*",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "@kisaki3/tooling": "workspace:*"
  }
}
