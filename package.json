{
  "name": "@kisaki3/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "24.11.1"
  },
  "scripts": {
    "desktop:dev": "turbo run dev --filter=@kisaki3/desktop",
    "desktop:build": "tsx tools/outputs/turbo.ts run build --filter=@kisaki3/desktop --",
    "desktop:package": "tsx tools/outputs/turbo.ts run package --filter=@kisaki3/desktop --",
    "desktop:test:native": "tsx tools/outputs/turbo.ts run test:native --filter=@kisaki3/desktop --",
    "desktop:test:browser": "tsx tools/outputs/turbo.ts run test:browser --filter=@kisaki3/desktop --",
    "desktop:test:e2e": "tsx tools/outputs/turbo.ts run test:e2e --filter=@kisaki3/desktop --",
    "desktop:test:artifacts": "pnpm --filter @kisaki3/desktop test:artifacts",
    "desktop:test:performance": "tsx tools/outputs/turbo.ts run test:performance --filter=@kisaki3/desktop --",
    "build": "tsx tools/outputs/turbo.ts run build",
    "typecheck": "tsx tools/outputs/turbo.ts run typecheck && tsx tools/outputs/run.ts --read-packages -- exec tsc -b",
    "lint": "tsx tools/outputs/run.ts --read-packages -- --shell-mode exec \"eslint . --max-warnings 0 && depcruise --config .dependency-cruiser.json clients tools\"",
    "lint:fix": "eslint . --fix",
    "test": "vitest run && tsx tools/outputs/turbo.ts run test",
    "test:outputs": "vitest run tests/tools/outputs",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "packages:pack": "tsx tools/release/package-inputs.ts",
    "test:consumers": "pnpm packages:pack && tsx tools/outputs/turbo.ts run test:consumers --filter=./clients/desktop/packages/* && pnpm test:consumers:run",
    "hooks:install": "tsx tools/hooks.ts install",
    "hooks:uninstall": "tsx tools/hooks.ts uninstall",
    "clean": "tsx tools/outputs/turbo.ts run clean",
    "test:consumers:run": "tsx tools/outputs/run.ts --read artifacts/packages -- exec vitest run --config config/vitest/vitest.config.consumers.ts",
    "desktop:test:dev": "tsx tools/outputs/turbo.ts run test:dev --filter=@kisaki3/desktop --",
    "outputs:turbo": "tsx tools/outputs/turbo.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "fs-native-extensions": "1.5.2",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
