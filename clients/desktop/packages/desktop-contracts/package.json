      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    },
    "./images": {
      "types": "./dist/images.d.ts",
      "import": "./dist/images.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
