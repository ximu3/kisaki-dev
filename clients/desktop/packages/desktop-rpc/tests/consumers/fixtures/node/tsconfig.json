{
  "compilerOptions": {
    "target": "ES2023",
    "rootDir": ".",
    "outDir": ".cache/node",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": false,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": ["*.ts"]
}
