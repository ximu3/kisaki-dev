{
  "name": "@kisaki3/workspace",
  "description": "Workspace tasks and repository engineering for Kisaki.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "24.11.1"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck root:typecheck",
    "root:typecheck": "tsc -b",
    "lint": "turbo run lint root:lint check:boundaries",
    "root:lint": "eslint \"*.config.ts\" tools tests --max-warnings 0",
    "lint:fix": "turbo run lint root:lint --cache=local:,remote: -- --fix",
    "check:boundaries": "depcruise --config .dependency-cruiser.json .",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "test": "turbo run test root:test",
    "root:test": "vitest run",
    "desktop:packages:pack": "turbo run build check:package --filter=./clients/desktop/packages/* && tsx tools/desktop/packages.ts",
    "desktop:test:consumers": "vitest run --config config/vitest/consumers.ts",
    "desktop:test:native": "pnpm desktop:test:build && turbo run test:native --filter=@kisaki3/desktop --",
    "desktop:test:e2e": "pnpm desktop:test:build && turbo run test:e2e --filter=@kisaki3/desktop --",
    "desktop:test:dev": "pnpm --filter @kisaki3/desktop build:native && turbo run test:dev --filter=@kisaki3/desktop --",
    "desktop:test:artifacts": "pnpm --filter @kisaki3/desktop test:artifacts",
    "desktop:test:performance": "pnpm desktop:test:build && turbo run test:performance --filter=@kisaki3/desktop --",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "install:hooks": "tsx tools/hooks.ts install",
    "uninstall:hooks": "tsx tools/hooks.ts uninstall",
    "clean": "turbo run clean",
    "desktop:test:build": "turbo run build --filter=@kisaki3/desktop --",
    "desktop:test:package": "turbo run test:package --filter=@kisaki3/desktop --"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@kisaki3/eslint-config": "workspace:*",
    "@kisaki3/tooling": "workspace:*",
    "@kisaki3/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "catalog:",
    "dependency-cruiser": "18.7.0",
    "eslint": "catalog:",
    "husky": "9.1.7",
    "jiti": "catalog:",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  }
}
