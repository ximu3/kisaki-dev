{
  "extends": ["//"],
  "tasks": {
    "runtime-inputs": {
      "dependsOn": ["^build"],
      "env": ["MACOSX_DEPLOYMENT_TARGET"],
      "inputs": [
        "tests/fixtures/runtime/src/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json",
        "tests/support/build-runtime.ts"
      ]
    },
    "build:native": {
      "inputs": ["native/**", "!native/target/**", "tools/native/**", "tools/lib/**"],
      "outputs": ["out/native/**", ".cache/native/**"],
      "env": ["MACOSX_DEPLOYMENT_TARGET"]
    },
    "prepare:resources": {
      "inputs": ["assets/**", "tools/resources/**", "tools/lib/**"],
      "outputs": ["out/resources/**"]
    },
    "prepare:test-runtime": {
      "dependsOn": ["runtime-inputs", "build:native", "prepare:resources"],
      "inputs": ["tests/support/build-runtime.ts"],
      "outputs": [
        "out/*/build.json",
        "out/*/package.json",
        "out/*/main/**",
        "out/*/preload/**",
        "out/*/renderer/**",
        "out/*/extension-host/**",
        "out/*/resources/**"
      ],
      "env": ["MACOSX_DEPLOYMENT_TARGET"]
    },
    "test:native": {
      "dependsOn": ["build:native", "prepare:resources"],
      "inputs": [
        "tests/integration/native/**",
        "tests/integration/database/**",
        "config/vitest/vitest.config.native.ts"
      ],
      "outputs": ["test-results/native/**"]
    },
    "test:electron": {
      "dependsOn": ["prepare:test-runtime"],
      "inputs": [
        "playwright.config.ts",
        "tests/tools/electron.test.ts",
        "tests/support/electron.ts",
        "tools/dev/electron-executable.ts"
      ],
      "outputs": ["test-results/runtime/**"]
    },
    "test:dev": {
      "dependsOn": ["build:native"],
      "env": ["TSDOWN_*", "MACOSX_DEPLOYMENT_TARGET"],
      "inputs": [
        "tools/dev/**",
        "tools/build/**",
        "tools/resources/**",
        "tools/native/**",
        "tools/lib/**",
        "native/**",
        "!native/target/**",
        "!**/*.md",
        "assets/**",
        "tests/fixtures/runtime/config/vite/**",
        "config/typescript/**",
        "tsconfig.json",
        "config/vitest/vitest.config.dev.ts",
        "tests/tools/dev/**",
        "tests/support/development*.ts",
        "tests/support/preparation-worker.ts",
        "tests/support/window-observation.ts",
        "!tests/fixtures/runtime/src/**/*.test.ts",
        "!tests/fixtures/runtime/src/**/*.test.tsx",
        "!tools/**/*.test.ts",
        "!native/**/*.test.ts",
        "!config/typescript/tsconfig.tests.json",
        "tests/fixtures/runtime/src/**",
        "tests/support/fixture-application.ts"
      ],
      "outputs": ["test-results/dev/**"]
    },
    "test:package": {
      "dependsOn": ["prepare:test-runtime"],
      "inputs": [
        "electron-builder.yml",
        "$TURBO_ROOT$/LICENSE",
        "tools/package/**",
        "playwright.config.ts",
        "tests/tools/package.test.ts",
        "tests/support/artifact*.ts",
        "tests/support/window-observation.ts",
        "tools/dev/electron-executable.ts"
      ],
      "env": ["MACOSX_DEPLOYMENT_TARGET"],
      "outputs": ["test-results/package/**", "dist/**"]
    },
    "check:native": {
      "dependsOn": ["build:native"],
      "inputs": ["native/**", "!native/target/**", "tools/native/**", "tools/lib/**"],
      "outputs": []
    }
  }
}
