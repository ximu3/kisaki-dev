{
  "name": "@kisaki3/desktop",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "imports": {
    "#native": "./native/node/index.ts"
  },
  "license": "AGPL-3.0-only",
  "description": "Desktop engineering tools, native file primitives, resources and verification.",
  "homepage": "https://github.com/ximu3/kisaki",
  "author": {
    "name": "ximu3",
    "email": "152481053+ximu3@users.noreply.github.com"
  },
  "scripts": {
    "build:fixture": "tsx tools/build/cli.ts --source tests/fixtures/runtime",
    "prepare:electron": "install-electron",
    "prepare:resources": "tsx tools/resources/cli.ts",
    "build:native": "tsx tools/native/cli.ts",
    "package:fixture": "tsx tools/package/cli.ts --test-only",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "check:boundaries": "pnpm --workspace-root exec tsx tools/boundaries.ts clients/desktop/app",
    "check:native": "tsx tools/native/cli.ts --check",
    "test": "vitest run",
    "test:native": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --config config/vitest/vitest.config.native.ts",
    "test:e2e": "playwright test",
    "test:dev": "vitest run --config config/vitest/vitest.config.dev.ts",
    "test:artifacts": "vitest run --config config/vitest/vitest.config.artifacts.ts",
    "test:performance": "playwright test --config config/playwright/playwright.config.performance.ts",
    "clean": "tsx tools/clean.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@kisaki3/eslint-config": "workspace:*",
    "@kisaki3/tooling": "workspace:*",
    "@kisaki3/typescript-config": "workspace:*",
    "@napi-rs/cli": "3.10.9",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "catalog:",
    "chokidar": "6.0.0",
    "cross-env": "10.1.0",
    "electron": "catalog:",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "eslint": "catalog:",
    "extract-zip": "2.0.1",
    "jiti": "catalog:",
    "playwright": "1.64.1",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5",
    "solid-js": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "napi": {
    "binaryName": "kisaki-native",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  }
}
