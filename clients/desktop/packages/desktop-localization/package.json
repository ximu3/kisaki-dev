{
  "name": "@kisaki3/desktop-localization",
  "version": "0.1.0-dev.0",
  "description": "English messages, typed translation calls and pure localization formatting for Kisaki.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki-dev.git",
    "directory": "clients/desktop/packages/desktop-localization"
  },
  "files": [
    "dist",
    "LICENSE",
    "release-notes"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsx tools/build.ts",
    "pack": "kisaki-package pack",
    "check:package": "kisaki-package check",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:consumers": "vitest run --config config/vitest/consumers.ts",
    "generate:messages": "tsx tools/generate-messages.ts",
    "clean": "tsx tools/clean.ts"
  },
  "dependencies": {
    "@kisaki3/desktop-contracts": "workspace:^",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "intl-messageformat": "12.1.4"
  },
  "devDependencies": {
    "@kisaki3/eslint-config": "workspace:*",
    "@kisaki3/tooling": "workspace:*",
    "@kisaki3/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "tsdown": "0.23.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
