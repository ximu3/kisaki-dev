{
  "name": "@kisaki3/desktop-ui",
  "version": "0.1.0-dev.0",
  "description": "Native Solid controls, charts, Markdown and drag interactions for Kisaki desktop interfaces.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki-dev.git",
    "directory": "clients/desktop/packages/desktop-ui"
  },
  "files": [
    "dist",
    "LICENSE",
    "release-notes"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "import": "./dist/link.js"
    },
    "./badge": {
      "types": "./dist/badge.d.ts",
      "import": "./dist/badge.js"
    },
    "./separator": {
      "types": "./dist/separator.d.ts",
      "import": "./dist/separator.js"
    },
