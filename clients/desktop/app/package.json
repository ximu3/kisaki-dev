{
  "name": "@kisaki3/desktop",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "imports": {
    "#native": "./native/node/index.ts"
  },
  "license": "AGPL-3.0-only",
  "description": "A local library for games, anime, comics and novels.",
  "homepage": "https://github.com/ximu3/kisaki",
  "author": {
    "name": "ximu3",
    "email": "152481053+ximu3@users.noreply.github.com"
  },
  "scripts": {
    "dev": "tsx tools/dev/cli.ts",
    "build": "tsx tools/build/cli.ts",
    "package": "tsx tools/package/cli.ts",
    "resources:prepare": "tsx tools/resources/cli.ts",
    "native:build": "tsx tools/native/cli.ts",
    "native:check": "tsx tools/native/cli.ts --check",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "test:native": "cross-env ELECTRON_RUN_AS_NODE=1 electron ../../../node_modules/vitest/vitest.mjs run --config config/vitest/vitest.config.native.ts",
    "test:browser": "vitest run --config config/vitest/vitest.config.browser.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:artifacts": "vitest run --config config/vitest/vitest.config.artifacts.ts",
    "test:performance": "playwright test --config config/playwright/playwright.config.performance.ts",
    "clean": "tsx tools/clean.ts",
    "test:dev": "vitest run --config config/vitest/vitest.config.dev.ts"
  },
  "dependencies": {
    "@kisaki3/appearance": "workspace:^",
    "@kisaki3/ui": "workspace:^",
    "solid-js": "catalog:",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "@types/node": "catalog:",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "@electron/fuses": "2.1.3",
    "@electron/asar": "4.3.1",
    "@napi-rs/cli": "3.10.9",
    "@playwright/test": "1.64.1",
    "@vitest/browser-playwright": "5.0.5",
    "@types/better-sqlite3": "9.6.0",
    "cross-env": "10.1.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-sans-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "catalog:",
    "sharp": "0.35.5",
    "png-to-ico": "3.0.2",
    "extract-zip": "2.0.1",
    "yaml": "2.9.1",
    "playwright": "1.64.1",
    "electron-builder-squirrel-windows": "26.15.3",
    "resolve.exports": "2.0.3"
  },
  "napi": {
    "binaryName": "kisaki-native",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  }
}
