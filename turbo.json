{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["TSDOWN_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:consumers": {
      "dependsOn": ["pack"],
      "cache": false
    },
    "pack": {
      "dependsOn": ["build"],
      "outputs": ["out/*.tgz"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "//#typecheck:root": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#lint:root": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "//#test:root": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#check:boundaries": {
      "dependsOn": [
        "@kisaki3/appearance#build",
        "@kisaki3/desktop-contracts#build",
        "@kisaki3/extension-api#build",
        "@kisaki3/extension-cli#build",
        "@kisaki3/extension-distribution#build",
        "@kisaki3/extension-sdk#build",
        "@kisaki3/rpc#build",
        "@kisaki3/ui#build"
      ],
      "outputs": []
    }
  }
}
