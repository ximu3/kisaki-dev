    "@kisaki3/desktop-appearance": "workspace:^",
    "@mdit/plugin-footnote": "1.1.3",
    "@mdit/plugin-tasklist": "1.1.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.12",
    "@unovis/solid": "1.7.1",
    "@unovis/ts": "1.7.1",
    "csstype": "3.2.3",
    "markdown-it": "15.0.3",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "solid-js": "~1.9.16"
  },
  "devDependencies": {
    "@kisaki3/eslint-config": "workspace:*",
    "@kisaki3/tooling": "workspace:*",
    "@kisaki3/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "solid-js": "catalog:",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-solid": "2.0.0",
    "vite": "catalog:",
