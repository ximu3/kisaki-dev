[
  {
    "id": "anime-episode-number",
    "workTypes": ["anime"],
    "rule": {
      "enabled": true,
      "input": "baseName",
      "pattern": "^(?<number>[0-9]+(?:\\.[0-9]+)?)$",
      "ignoreCase": false,
      "output": {
        "targets": [
          {
            "kind": "episode",
            "episodeType": "regular",
            "number": {
              "kind": "single",
              "value": "$<number>",
              "offset": 0
            }
          }
        ]
      }
    }
  },
  {
    "id": "anime-title-episode-number",
