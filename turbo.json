{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalDependencies": [
    ".node-version",
    ".npmrc",
    "pnpm-workspace.yaml",
    ".github/workflows/ci.yml",
    ".github/workflows/verification.yml",
    ".github/workflows/verification-repository.yml",
    ".github/workflows/verification-desktop.yml"
  ],
  "tasks": {
    "check:package": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!tests/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!vitest.config.ts",
        "!playwright.config.ts",
        "!config/vitest/**",
        "!config/playwright/**",
        "!config/typescript/tsconfig.tests.json",
        "!eslint.config.ts"
      ],
      "outputs": ["dist/**"],
      "env": ["TSDOWN_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/packages/eslint-config/src/**",
        "$TURBO_ROOT$/packages/eslint-config/package.json",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "//#root:typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "//#root:lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "tsconfig.json",
        "config/typescript/**",
        "*.config.ts",
        "config/**/*.ts",
        "tools/**/*.ts",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "$TURBO_ROOT$/packages/eslint-config/src/**",
        "$TURBO_ROOT$/packages/eslint-config/package.json",
        "$TURBO_ROOT$/packages/typescript-config/*.json"
      ],
      "outputs": []
    },
    "//#root:test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "//#check:boundaries": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/tests/**/fixtures/**",
        "!refactor/**",
        "!.github/**"
      ],
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#root:pack:desktop": {
      "dependsOn": ["@kisaki3/desktop-appearance#check:package"],
      "inputs": [
        "package.json",
        "tools/desktop/packages.ts",
        "clients/desktop/packages/*/README.md",
        "clients/desktop/packages/*/LICENSE",
        "clients/desktop/packages/*/release-notes/**"
      ],
      "outputs": ["artifacts/desktop/packages/**"]
    },
    "//#root:test:consumers": {
      "dependsOn": ["root:pack:desktop"],
      "inputs": ["package.json", "tests/desktop/consumers/**", "config/vitest/consumers.ts"],
      "outputs": ["test-results/consumers/**"]
    }
  },
  "globalEnv": ["CI", "ImageOS", "ImageVersion", "DESKTOP_TARGET"]
}
