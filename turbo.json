{
  "$schema": "https://turborepo.dev/schema.json",
  "futureFlags": { "affectedUsingTaskInputs": true },
  "globalDependencies": [
    ".node-version",
    ".npmrc",
    "pnpm-workspace.yaml",
    ".github/workflows/*.yml",
    "config/turbo/verification.graphql"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!tests/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!vitest.config.ts",
        "!config/vitest/**"
      ],
      "outputs": ["dist/**"],
      "env": ["TSDOWN_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [],
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": [],
      "cache": false
    },
    "test:consumers": {
      "dependsOn": ["pack"],
      "inputs": ["package.json"],
      "cache": false
    },
    "pack": {
      "dependsOn": ["build"],
      "inputs": ["package.json", "README.md", "LICENSE", "LICENSE.*", ".npmignore"],
      "outputs": ["out/*.tgz"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "transit": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "dependsOn": ["^transit"]
    },
    "//#typecheck:root": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "//#lint:root": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "//#test:root": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "cache": false
    },
    "//#test:consumers:run": {
      "inputs": [
        "tests/consumers/**",
        "tests/support/**",
        "config/vitest/vitest.config.consumers.ts",
        "config/typescript/**",
        "tools/release/**",
        "tsconfig.json"
      ],
      "cache": false
    },
    "//#check:boundaries": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "dependsOn": [
        "@kisaki3/appearance#build",
        "@kisaki3/desktop-contracts#build",
        "@kisaki3/extension-api#build",
        "@kisaki3/extension-cli#build",
        "@kisaki3/extension-distribution#build",
        "@kisaki3/extension-sdk#build",
        "@kisaki3/rpc#build",
        "@kisaki3/ui#build"
      ],
      "outputs": []
    }
  }
}
