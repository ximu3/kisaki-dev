{
  "name": "@kisaki3/extension-distribution",
  "version": "0.1.0-dev.0",
  "description": "Extension manifests, registry formats, compatibility rules and Ed25519 signing for Kisaki.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki-dev.git",
    "directory": "clients/desktop/packages/extension-distribution"
  },
  "files": [
    "dist",
    "LICENSE",
    "release-notes"
  ],
  "sideEffects": false,
  "exports": {
    "./manifest": {
      "kisaki-source": "./src/manifest.ts",
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./registry": {
      "kisaki-source": "./src/registry.ts",
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./metadata": {
      "kisaki-source": "./src/metadata.ts",
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    },
    "./compatibility": {
      "kisaki-source": "./src/compatibility.ts",
      "types": "./dist/compatibility.d.ts",
      "import": "./dist/compatibility.js"
    },
    "./errors": {
      "kisaki-source": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./node/signing": {
      "kisaki-source": "./src/node/signing.ts",
      "types": "./dist/node/signing.d.ts",
      "import": "./dist/node/signing.js"
    }
  },
  "scripts": {
    "typecheck:project": "tsc -b",
    "clean:outputs": "kisaki-package clean",
    "test:unit": "vp test run"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "0.10.1",
    "canonicalize": "5.1.0",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@kisaki3/tooling": "workspace:*",
    "@kisaki3/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "catalog:",
    "@types/semver": "7.8.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
