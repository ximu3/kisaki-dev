{
  "name": "@kisaki3/desktop-appearance",
  "version": "0.1.0-dev.0",
  "description": "Framework-independent visual tokens, values and styles for Kisaki.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki-dev.git",
    "directory": "clients/desktop/packages/desktop-appearance"
  },
  "files": [
    "dist",
    "LICENSE",
    "release-notes"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens": {
      "kisaki-source": "./src/tokens.ts",
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./values": {
      "kisaki-source": "./src/values.ts",
      "types": "./dist/values.d.ts",
      "import": "./dist/values.js"
    },
    "./defaults": {
      "kisaki-source": "./src/defaults.ts",
      "types": "./dist/defaults.d.ts",
      "import": "./dist/defaults.js"
    },
    "./styles.css": {
      "kisaki-source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./tailwind.css": {
      "kisaki-source": "./src/tailwind.css",
      "default": "./dist/tailwind.css"
    }
  },
  "scripts": {
    "typecheck:project": "tsc -b",
    "clean:outputs": "kisaki-package clean",
    "test:unit": "vp test run",
    "generate:styles": "vpx tools/styles.ts --generate"
  },
  "devDependencies": {
    "@kisaki3/tooling": "workspace:*",
    "@kisaki3/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/css-tree": "3.2.0",
    "@types/node": "catalog:",
    "css-tree": "3.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
