{
  "name": "@kisaki3/desktop-localization",
  "version": "0.1.0-dev.0",
  "description": "English messages, typed translation calls and pure localization formatting for Kisaki.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximu3/kisaki-dev.git",
    "directory": "clients/desktop/packages/desktop-localization"
  },
  "files": [
    "dist",
    "LICENSE",
    "release-notes"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "kisaki-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck:project": "tsc -b",
    "clean:outputs": "kisaki-package clean",
    "test:unit": "vp test run",
    "generate:messages": "vpx tools/generate-messages.ts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@kisaki3/desktop-contracts": "workspace:^",
    "intl-messageformat": "12.1.4"
  },
  "devDependencies": {
    "@kisaki3/tooling": "workspace:*",
    "@kisaki3/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
